# Copy to .env and fill in. .env is gitignored — never commit it.
# docker compose reads .env automatically.

# Host directory holding the SQLite database + uploaded documents. REQUIRED
# (no fallback). This is health data — keep it off the repo and off /data/photos.
# Production:
FH_DATA_DIR=/data/tech-station/family-health/data
# Local dev example instead:
# FH_DATA_DIR=./data
