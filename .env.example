# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# docker compose reads .env automatically.

# Host directory for uploaded documents + postgres data. REQUIRED (no fallback).
# Production (this is health data — keep it off the repo and off /data/photos):
FH_DATA_DIR=/data/tech-station/family-health/data
# Local dev example instead:
# FH_DATA_DIR=./data

# Postgres password for the health_app user. REQUIRED. Use a real secret in prod.
POSTGRES_PASSWORD=change_this_later
